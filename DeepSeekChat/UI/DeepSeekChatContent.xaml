<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml">

    <Grid x:Name="RootGrid" MinWidth="320" Background="{Binding Theme.BgPrimary}">

        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- Styles hold only static values: Remote UI does not allow bindings inside Setters.
                 Theme colors are set on the elements themselves: Background/Foreground are the normal colors,
                 BorderBrush is the hover highlight color (shown by the hv layer in the template). -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                                <Border x:Name="hv" Background="{TemplateBinding BorderBrush}" CornerRadius="6" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hv" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="14,8"/>
            </Style>

            <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- A choice in Settings: an "off" and an "on" button are stacked and IsSelected swaps them. -->
            <Style x:Key="OptionOff" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="12,7"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OptionOn" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The "+" button ignores clicks while its list is open, so the list does not flicker on a second click. -->
            <Style x:Key="PlusButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Padding" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOpen, ElementName=AttachPopup}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Message header: the model or user color is picked through visibility based on IsAi. -->
            <Style x:Key="HeaderAi" TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAi}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="HeaderUser" TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAi}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Model button: ignores clicks while its list is open, like the "+" button. -->
            <Style x:Key="ModelButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOpen, ElementName=ModelPopup}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{Binding Theme.BgSecondary}"
                BorderBrush="{Binding Theme.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="←" ToolTip="{Binding T.Back}"
                        Style="{StaticResource ToolbarButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}" FontSize="18"
                        Visibility="{Binding Navigation.ShowBack, Converter={StaticResource B2V}}"
                        Command="{Binding ShowChatCommand}"/>

                <TextBlock Grid.Column="1" Text="DeepSeek" VerticalAlignment="Center" Margin="6,0,0,0"
                           FontSize="18" FontWeight="SemiBold" Foreground="{Binding Theme.TextPrimary}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋" ToolTip="{Binding T.NewChat}" Style="{StaticResource ToolbarButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}"
                            Command="{Binding Conversation.NewChatCommand}"/>
                    <Button Content="📜" ToolTip="{Binding T.History}" Style="{StaticResource ToolbarButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}"
                            Command="{Binding ShowHistoryCommand}"/>
                    <Button Content="🗑" ToolTip="{Binding T.DeleteChat}" Style="{StaticResource ToolbarButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}"
                            Command="{Binding Conversation.DeleteChatCommand}"/>
                    <Button Content="⚙" ToolTip="{Binding T.Settings}" Style="{StaticResource ToolbarButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}"
                            Command="{Binding ShowSettingsCommand}"/>
                    <Button Content="👤" ToolTip="{Binding T.Account}" Style="{StaticResource ToolbarButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}"
                            Command="{Binding ShowAccountCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pages: stacked in one cell and switched by visibility -->
        <Grid Grid.Row="1">

            <!-- Chat page -->
            <Grid Visibility="{Binding Navigation.IsChatView, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">

                        <!-- Welcome block -->
                        <StackPanel HorizontalAlignment="Left" Margin="0,10,0,10"
                                    Visibility="{Binding Conversation.ShowWelcome, Converter={StaticResource B2V}}">
                            <Grid Width="80" Height="80" HorizontalAlignment="Left" Margin="0,0,0,15">
                                <Border Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{Binding AvatarBrush}"/>
                            </Grid>

                            <TextBlock Text="{Binding T.WelcomeTitle}" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding Theme.TextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding T.WelcomeSub}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{Binding Theme.TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding T.WelcomeDesc}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{Binding Theme.TextSecondary}" Margin="0,0,0,15"/>

                            <Button Style="{StaticResource QuickActionButton}" Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextPrimary}" BorderBrush="{Binding Theme.BgHover}"
                                    Command="{Binding Conversation.QuickActionCommand}" CommandParameter="{Binding T.QuickExplain}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡 "/>
                                    <TextBlock Text="{Binding T.QuickExplain}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextPrimary}" BorderBrush="{Binding Theme.BgHover}"
                                    Command="{Binding Conversation.QuickActionCommand}" CommandParameter="{Binding T.QuickFix}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡 "/>
                                    <TextBlock Text="{Binding T.QuickFix}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextPrimary}" BorderBrush="{Binding Theme.BgHover}"
                                    Command="{Binding Conversation.QuickActionCommand}" CommandParameter="{Binding T.QuickTests}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡 "/>
                                    <TextBlock Text="{Binding T.QuickTests}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextPrimary}" BorderBrush="{Binding Theme.BgHover}"
                                    Command="{Binding Conversation.QuickActionCommand}" CommandParameter="{Binding T.QuickOptimize}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡 "/>
                                    <TextBlock Text="{Binding T.QuickOptimize}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Messages -->
                        <ItemsControl ItemsSource="{Binding Conversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Theme.BgSecondary}" CornerRadius="8"
                                            Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="14"
                                                               VerticalAlignment="Center" Style="{StaticResource HeaderUser}"
                                                               Foreground="{Binding Theme.TextSecondary}"/>
                                                    <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="14"
                                                               VerticalAlignment="Center" Style="{StaticResource HeaderAi}"
                                                               Foreground="{Binding Theme.TextPrimary}"/>
                                                </Grid>
                                                <Button Grid.Column="1" Content="{Binding CopyLabel}" ToolTip="{Binding T.Copy}"
                                                        Style="{StaticResource FlatButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}"
                                                        Command="{Binding CopyCommand}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Thumbnails}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasThumbnails, Converter={StaticResource B2V}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="72" Height="72" CornerRadius="8" Margin="0,0,6,6"
                                                                Background="{Binding Brush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                                                     TextWrapping="Wrap" FontSize="13" Padding="0,8,0,0"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{Binding Theme.TextPrimary}"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     HorizontalScrollBarVisibility="Disabled"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding T.Typing}" Margin="0,10,0,10" Foreground="{Binding Theme.TextSecondary}"
                                   Visibility="{Binding Conversation.IsTyping, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input panel -->
                <Border Grid.Row="1" Background="{Binding Theme.BgSecondary}"
                        BorderBrush="{Binding Theme.Border}" BorderThickness="0,1,0,0" Padding="10">
                    <StackPanel>

                        <!-- Attached files and photos -->
                        <ItemsControl ItemsSource="{Binding Conversation.Attachments}" Margin="0,0,0,8"
                                      Visibility="{Binding Conversation.HasAttachments, Converter={StaticResource B2V}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Theme.BgHover}" CornerRadius="12"
                                            Padding="10,3,4,3" Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Foreground="{Binding Theme.TextPrimary}"/>
                                            <Button Content="✕" Style="{StaticResource FlatButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}" Padding="6,0"
                                                    Margin="4,0,0,0" Command="{Binding RemoveCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- The "+" button with a drop-up list -->
                            <Button x:Name="PlusButton" Grid.Column="0" Content="＋" Margin="0,0,8,0"
                                    ToolTip="{Binding T.Attach}" Style="{StaticResource PlusButton}" Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextPrimary}" BorderBrush="{Binding Theme.BgHover}"
                                    Command="{Binding Conversation.OpenAttachMenuCommand}"/>
                            <Popup x:Name="AttachPopup" PlacementTarget="{Binding ElementName=PlusButton}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding Conversation.IsAttachMenuOpen, Mode=TwoWay}">
                                <Border Background="{Binding Theme.BgSecondary}" BorderBrush="{Binding Theme.Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,6">
                                    <StackPanel MinWidth="170">
                                        <Button Style="{StaticResource MenuItemButton}" Foreground="{Binding Theme.TextPrimary}" BorderBrush="{Binding Theme.BgHover}" Command="{Binding Conversation.AddPhotoCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🖼  "/>
                                                <TextBlock Text="{Binding T.AddPhoto}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenuItemButton}" Foreground="{Binding Theme.TextPrimary}" BorderBrush="{Binding Theme.BgHover}" Command="{Binding Conversation.AddFileCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📎  "/>
                                                <TextBlock Text="{Binding T.AddFile}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Grid Grid.Column="1">
                                <TextBox Text="{Binding Conversation.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="40" MaxHeight="150" Padding="10" TextWrapping="Wrap"
                                         AcceptsReturn="False" VerticalContentAlignment="Center"
                                         Background="{Binding Theme.BgPrimary}"
                                         Foreground="{Binding Theme.TextPrimary}"
                                         CaretBrush="{Binding Theme.TextPrimary}"
                                         BorderBrush="{Binding Theme.Border}" BorderThickness="1"
                                         VerticalScrollBarVisibility="Auto">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding Conversation.SendCommand}"
                                                    CommandParameter="{Binding Conversation.InputText}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <TextBlock Text="{Binding T.Placeholder}" IsHitTestVisible="False"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Theme.TextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Conversation.InputText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="2" Content="➤" Margin="8,0,0,0" Width="44" FontSize="18"
                                    Style="{StaticResource AccentButton}" Background="{Binding Theme.Accent}" Foreground="{Binding Theme.AccentText}" BorderBrush="{Binding Theme.Accent}"
                                    Command="{Binding Conversation.SendCommand}" CommandParameter="{Binding Conversation.InputText}"
                                    IsEnabled="{Binding Conversation.SendCommand.RunningCommandsCount.IsZero}"/>
                        </Grid>

                        <!-- Model picker -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ModelButton" Style="{StaticResource ModelButton}"
                                    Background="{Binding Theme.BgPrimary}" Foreground="{Binding Theme.TextPrimary}"
                                    BorderBrush="{Binding Theme.BgHover}" ToolTip="{Binding T.ModelLabel}"
                                    Command="{Binding ModelPicker.OpenMenuCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ModelPicker.SelectedName}"/>
                                    <TextBlock Text=" ▾"/>
                                </StackPanel>
                            </Button>
                            <Popup x:Name="ModelPopup" PlacementTarget="{Binding ElementName=ModelButton}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding ModelPicker.IsMenuOpen, Mode=TwoWay}">
                                <Border Background="{Binding Theme.BgSecondary}" BorderBrush="{Binding Theme.Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,6">
                                    <ItemsControl ItemsSource="{Binding ModelPicker.Models}" MinWidth="190">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Button Content="{Binding Label}" Style="{StaticResource OptionOff}"
                                                            Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextPrimary}"
                                                            BorderBrush="{Binding Theme.BgHover}" Margin="0,0,0,2"
                                                            HorizontalContentAlignment="Left"
                                                            Command="{Binding SelectCommand}"/>
                                                    <Button Content="{Binding Label}" Style="{StaticResource OptionOn}"
                                                            Background="{Binding Theme.Accent}" Foreground="{Binding Theme.AccentText}"
                                                            BorderBrush="{Binding Theme.Accent}" Margin="0,0,0,2"
                                                            HorizontalContentAlignment="Left"
                                                            Command="{Binding SelectCommand}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- History page -->
            <Grid Margin="20" Visibility="{Binding Navigation.IsHistoryView, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding T.HistoryTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{Binding Theme.TextPrimary}" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding T.HistoryEmpty}" Foreground="{Binding Theme.TextSecondary}"
                                   Visibility="{Binding History.IsEmpty, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding History.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Theme.BgSecondary}" CornerRadius="6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource FlatButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}"
                                                    HorizontalContentAlignment="Left" Padding="12"
                                                    Command="{Binding OpenCommand}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Foreground="{Binding Theme.TextPrimary}"/>
                                                    <TextBlock Text="{Binding UpdatedAtText}" FontSize="11" Margin="0,5,0,0"
                                                               Foreground="{Binding Theme.TextSecondary}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Content="🗑" ToolTip="{Binding T.DeleteChat}"
                                                    Style="{StaticResource ToolbarButton}" Foreground="{Binding Theme.TextSecondary}" BorderBrush="{Binding Theme.BgHover}" Margin="4,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DeleteCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Settings page -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding Navigation.IsSettingsView, Converter={StaticResource B2V}}">
                <StackPanel Margin="25">
                    <TextBlock Text="{Binding T.SettingsTitle}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{Binding Theme.TextPrimary}" Margin="0,0,0,20"/>

                    <!-- Language -->
                    <TextBlock Text="{Binding T.LanguageLabel}" FontSize="13"
                               Foreground="{Binding Theme.TextSecondary}" Margin="0,0,0,7"/>
                    <ItemsControl ItemsSource="{Binding Settings.Languages}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Content="{Binding Label}" Style="{StaticResource OptionOff}"
                                            Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextSecondary}"
                                            BorderBrush="{Binding Theme.BgHover}" Margin="0,0,6,6"
                                            Command="{Binding SelectCommand}"/>
                                    <Button Content="{Binding Label}" Style="{StaticResource OptionOn}"
                                            Background="{Binding Theme.Accent}" Foreground="{Binding Theme.AccentText}"
                                            BorderBrush="{Binding Theme.Accent}" Margin="0,0,6,6"
                                            Command="{Binding SelectCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Theme -->
                    <TextBlock Text="{Binding T.ThemeLabel}" FontSize="13"
                               Foreground="{Binding Theme.TextSecondary}" Margin="0,0,0,7"/>
                    <ItemsControl ItemsSource="{Binding Settings.Themes}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Style="{StaticResource OptionOff}"
                                            Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextSecondary}"
                                            BorderBrush="{Binding Theme.BgHover}" Margin="0,0,6,6"
                                            Command="{Binding SelectCommand}">
                                        <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,7,0"
                                                VerticalAlignment="Center" Background="{Binding Swatch}"
                                                BorderBrush="{Binding Theme.TextSecondary}" BorderThickness="1"/>
                                        <TextBlock Text="{Binding Label}"/>
                                    </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OptionOn}"
                                            Background="{Binding Theme.Accent}" Foreground="{Binding Theme.AccentText}"
                                            BorderBrush="{Binding Theme.Accent}" Margin="0,0,6,6"
                                            Command="{Binding SelectCommand}">
                                        <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,7,0"
                                                VerticalAlignment="Center" Background="{Binding Swatch}"
                                                BorderBrush="{Binding Theme.TextSecondary}" BorderThickness="1"/>
                                        <TextBlock Text="{Binding Label}"/>
                                    </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- API key -->
                    <TextBlock Text="{Binding T.ApiKeyLabel}" FontSize="13"
                               Foreground="{Binding Theme.TextSecondary}" Margin="0,0,0,7"/>
                    <TextBox Text="{Binding Settings.ApiKeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Padding="10" VerticalContentAlignment="Center"
                             Visibility="{Binding Settings.IsKeyEditable, Converter={StaticResource B2V}}"
                             Background="{Binding Theme.BgSecondary}"
                             Foreground="{Binding Theme.TextPrimary}"
                             CaretBrush="{Binding Theme.TextPrimary}"
                             BorderBrush="{Binding Theme.Border}" BorderThickness="1"/>

                    <!-- Saved key: shown as asterisks with a Change button -->
                    <Grid Visibility="{Binding Settings.IsKeyMasked, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="40" Padding="10,0" CornerRadius="4"
                                Background="{Binding Theme.BgSecondary}"
                                BorderBrush="{Binding Theme.Border}" BorderThickness="1">
                            <TextBlock Text="{Binding Settings.MaskedKey}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Theme.TextPrimary}"/>
                        </Border>
                        <Button Grid.Column="1" Margin="8,0,0,0" Height="40" MinWidth="90"
                                Style="{StaticResource QuickActionButton}"
                                Background="{Binding Theme.BgSecondary}" Foreground="{Binding Theme.TextPrimary}"
                                BorderBrush="{Binding Theme.BgHover}"
                                Content="{Binding T.ChangeKey}"
                                Command="{Binding Settings.EditKeyCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding Settings.Status}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{Binding Settings.StatusColor}"/>
                    <TextBlock Text="{Binding T.SettingsInfo}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,15"
                               Foreground="{Binding Theme.TextSecondary}"/>
                    <Button Content="{Binding T.Save}" MinWidth="110" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButton}" Background="{Binding Theme.Accent}" Foreground="{Binding Theme.AccentText}" BorderBrush="{Binding Theme.Accent}"
                            Visibility="{Binding Settings.IsKeyEditable, Converter={StaticResource B2V}}"
                            Command="{Binding Settings.SaveCommand}" CommandParameter="{Binding Settings.ApiKeyText}"
                            IsEnabled="{Binding Settings.SaveCommand.RunningCommandsCount.IsZero}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Account page -->
            <Grid Margin="25" VerticalAlignment="Top"
                  Visibility="{Binding Navigation.IsAccountView, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="{Binding T.AccountTitle}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{Binding Theme.TextPrimary}" Margin="0,0,0,15"/>

                <TextBlock Grid.Row="1" Text="{Binding T.ApiKeyField}" Foreground="{Binding Theme.TextSecondary}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Account.KeyStatus}"
                           Foreground="{Binding Theme.Success}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Text="{Binding T.BalanceField}" Foreground="{Binding Theme.TextSecondary}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Account.Balance}"
                           Foreground="{Binding Theme.TextPrimary}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Text="{Binding T.StatusField}" Foreground="{Binding Theme.TextSecondary}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Account.Status}"
                           Foreground="{Binding Theme.Success}"/>

                <!-- The name DeepSeek uses to address the user -->
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding T.NameLabel}" FontSize="13"
                           Foreground="{Binding Theme.TextSecondary}" Margin="0,28,0,7"/>
                <TextBox Grid.Row="5" Grid.ColumnSpan="2"
                         Text="{Binding Account.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="40" Padding="10" VerticalContentAlignment="Center"
                         Background="{Binding Theme.BgSecondary}"
                         Foreground="{Binding Theme.TextPrimary}"
                         CaretBrush="{Binding Theme.TextPrimary}"
                         BorderBrush="{Binding Theme.Border}" BorderThickness="1"/>
                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding T.NameHint}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{Binding Theme.TextSecondary}"/>
                <Grid Grid.Row="7" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Account.NameStatus}" VerticalAlignment="Center"
                               Foreground="{Binding Theme.Success}"/>
                    <Button Grid.Column="1" Content="{Binding T.Save}" MinWidth="110"
                            Style="{StaticResource AccentButton}"
                            Background="{Binding Theme.Accent}" Foreground="{Binding Theme.AccentText}"
                            BorderBrush="{Binding Theme.Accent}"
                            Command="{Binding Account.SaveNameCommand}" CommandParameter="{Binding Account.UserName}"/>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</DataTemplate>
